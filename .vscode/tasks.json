    // =========================================
    {
      "label": "eval_model",
      "type": "shell",
      "command": "bazel6 build tensorflow/lite/examples/secda_apps/eval_model:eval_model -c dbg --cxxopt='-DSYSC' --define tflite_with_xnnpack=false --verbose_failures",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "eval_model_plus_vm_v5",
      "type": "shell",
      "command": "bazel6 build tensorflow/lite/delegates/utils/secda_delegates/vm_delegate/v5:eval_model_plus_vm_delegate -c dbg --cxxopt='-DSYSC' --define tflite_with_xnnpack=false --verbose_failures",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
